---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { langs, forLang, products, research, links, path } from '../../lib/content.mjs';
export function getStaticPaths() { return langs.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang;
const t = forLang(lang);
---
<SiteLayout lang={lang}>
  <section class="hero"><div class="container hero-grid">
    <div>
      <div class="eyebrow">{t.heroEyebrow}</div>
      <h1>{t.heroTitle}</h1>
      <p>{t.heroDesc}</p>
      <div class="button-row">
        <a class="btn btn-primary" href={path(lang, 'products')}>{t.viewProducts} <span aria-hidden="true">→</span></a>
        <a class="btn btn-outline" href={links.market} target="_blank" rel="noopener noreferrer">{t.viewForge} ↗</a>
      </div>
      <div class="highlights"><span>✓ 4 MQL5</span><span>✓ 3 FREE</span><span>✓ {lang === 'vi' ? 'Backtest có nguồn' : 'Sourced research'}</span></div>
    </div>
    <div class="illustration" role="img" aria-label={t.illustration}>
      <div class="il-top"><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="il-name">SMC RESEARCH / XAUUSD</span></div>
      <div class="il-grid">
        <div class="il-chart"><div class="il-zone"></div><div class="il-zone last"></div>
          <svg viewBox="0 0 430 210" aria-hidden="true" focusable="false">
            <path d="M0 168L39 160L77 133L101 142L139 105L166 115L200 87L227 101L255 68L292 89L331 55L369 70L400 31L430 42" stroke="#80baef" stroke-width="2.6" fill="none"/>
            <path d="M0 168L39 160L77 133L101 142L139 105L166 115L200 87L227 101L255 68L292 89L331 55L369 70L400 31L430 42L430 210L0 210Z" fill="#4b8cc9" opacity=".08"/>
            <circle cx="255" cy="68" r="4" fill="#8bd4b5"/><circle cx="400" cy="31" r="4" fill="#8bd4b5"/>
          </svg>
        </div>
        <div class="il-side"><span>SMC Forge</span><strong>RESEARCH</strong><span>OB · FVG</span><span>Liquidity</span><span>POI</span></div>
      </div>
      <div class="il-footer">{t.illustration}</div>
    </div>
  </div></section>

  <section class="section" id="products"><div class="container">
    <div class="section-top"><div><div class="eyebrow">{t.verifiedCatalog}</div><h2>{t.catalogTitle}</h2><p class="section-summary">{t.catalogDesc}</p></div><a class="text-link" href={path(lang, 'products')}>{t.viewProducts} →</a></div>
    <div class="product-grid">{products.map(product => <ProductCard product={product} lang={lang} />)}</div>
  </div></section>

  <section class="section section-soft"><div class="container feature-grid">
    <div><div class="eyebrow">{t.categoryEA} · SMC</div><h2>SMC Forge</h2><p class="section-summary">{lang === 'vi' ? 'Các chiến lược SMC, lựa chọn chế độ vào lệnh và quản lý vị thế. Thông tin phiên bản và giá hiện tại được công bố trên MQL5.' : 'Smart Money Concepts workflows, entry modes and position management. See the published version and current pricing on MQL5.'}</p>
      <ul class="feature-list"><li>POI Reaction / Liquidity Sweep / FVG Retracement</li><li>Multi-timeframe context</li><li>SL/TP · Break-even · Trailing</li></ul>
      <a class="btn btn-primary" target="_blank" rel="noopener noreferrer" href={links.market}>{t.currentPrice} ↗</a>
    </div>
    <div class="feature-panel" aria-label="SMC Forge summary"><small>EXPERT ADVISOR / MT5</small><strong>SMC Forge</strong><small>Published Market product #193733</small><div class="mini-state"><span>Strategy / POI · Sweep · FVG</span><span>Context / Market Structure</span><span>Position / Risk management</span></div></div>
  </div></section>

  <section class="section"><div class="container"><div class="section-top"><div><div class="eyebrow">RESEARCH</div><h2>{t.researchTitle}</h2><p class="section-summary">{t.researchIntro}</p></div><a class="text-link" href={path(lang, 'research')}>{t.nav.research} →</a></div>
    <div class="facts"><div class="fact"><span>{t.symbol}</span><strong>XAUUSD</strong></div><div class="fact"><span>{t.startCapital}</span><strong>$1,000</strong></div><div class="fact"><span>{t.lot}</span><strong>0.01</strong></div><div class="fact"><span>{t.period}</span><strong>01–08/2026</strong></div></div>
    <div style="height:20px"></div><div class="table-wrap"><table><thead><tr><th>{t.profile}</th><th>{t.netProfit}</th><th>{t.pf}</th><th>{t.dd}</th><th>{t.trades}</th><th>{t.positive}</th></tr></thead><tbody>{research.profiles.map(p=><tr><td><strong>{p.name}</strong></td><td>${p.profit_usd.toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2})}</td><td>{p.profit_factor.toFixed(2)}</td><td>{p.drawdown_pct.toFixed(2)}%</td><td>{p.trades}</td><td>{p.positive_months}/{p.total_months}</td></tr>)}</tbody></table></div>
    <div style="height:15px"></div><div class="warning">{t.risk} <a class="text-link" href={links.research} target="_blank" rel="noopener noreferrer">{t.source} ↗</a></div>
  </div></section>
</SiteLayout>
